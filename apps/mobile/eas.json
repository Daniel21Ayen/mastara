{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-arm64": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "EXPO_PUBLIC_API_URL": "https://api.REPLACE-WITH-YOUR-DOMAIN",
        "EXPO_PUBLIC_PROTECT_CONTENT": "true",
        "EXPO_PUBLIC_DB_ENCRYPTION": "false"
      }
    },
    "preview-arm32": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a",
        "EXPO_PUBLIC_API_URL": "https://api.REPLACE-WITH-YOUR-DOMAIN",
        "EXPO_PUBLIC_PROTECT_CONTENT": "true",
        "EXPO_PUBLIC_DB_ENCRYPTION": "false"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.REPLACE-WITH-YOUR-DOMAIN",
        "EXPO_PUBLIC_PROTECT_CONTENT": "true",
        "EXPO_PUBLIC_DB_ENCRYPTION": "false"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
