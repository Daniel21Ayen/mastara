# Phase 1-9 run on mock data. Set to false once the API exists.
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_API_URL=http://localhost:3000
# Encrypt the on-phone database (SQLCipher). Needs a development build, not Expo Go.
EXPO_PUBLIC_DB_ENCRYPTION=false
# Block screenshots and screen recording and show a watermark while signed in. Set to false only to capture design or support screenshots.
EXPO_PUBLIC_PROTECT_CONTENT=true
