{
  "name": "@mastara/database",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "prisma": "prisma",
    "generate": "prisma generate --schema=prisma/schema",
    "validate": "prisma validate --schema=prisma/schema",
    "migrate:dev": "prisma migrate dev --schema=prisma/schema",
    "migrate:deploy": "prisma migrate deploy --schema=prisma/schema",
    "db:push": "prisma db push --schema=prisma/schema",
    "db:seed": "ts-node src/seed-reference.ts",
    "build": "tsc -b",
    "lint": "tsc --noEmit",
    "db:seed:reference": "ts-node src/seed-reference.ts",
    "db:seed:demo": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "prisma": "7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
