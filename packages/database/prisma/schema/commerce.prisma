// ==============================================================================
// Partition E: Commerce, Payments, Durations and Per-Course Entitlements
// Requirements: FR-090 to FR-102, FR-120 to FR-132, D6, D7
// ==============================================================================

enum ProductType {
  BUNDLE
  SINGLE
  EXTRA
  FULL_STREAM
  FULL_BOTH
}

enum StreamScope {
  NATURAL
  SOCIAL
  BOTH
  ANY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CBE_MOBILE
  CBE_BIRR
  TELEBIRR
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Product {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           ProductType
  stream_scope   StreamScope  @default(ANY)
  name_en        String
  name_am        String
  description_en String?      @db.Text
  description_am String?      @db.Text
  price_etb      Decimal      @db.Decimal(10, 2)
  duration_days  Int
  min_courses    Int?
  max_courses    Int?
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @updatedAt @db.Timestamptz(6)

  price_rules    PriceRule[]
  orders         Order[]

  @@index([type, is_active])
  @@map("products")
}

model PriceRule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  tier_no    Int
  price_etb  Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, tier_no])
  @@map("price_rules")
}

model Order {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id    String         @db.Uuid
  product_id    String         @db.Uuid
  stream        Stream?
  quoted_amount Decimal        @db.Decimal(10, 2)
  status        OrderStatus    @default(PENDING_PAYMENT)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)

  student       Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  items         OrderItem[]
  proof         PaymentProof?
  entitlements  Entitlement[]

  @@index([student_id, status])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String   @db.Uuid
  course_id       String   @db.Uuid
  price_component Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [course_id], references: [id], onDelete: Restrict)

  @@unique([order_id, course_id])
  @@index([order_id])
  @@map("order_items")
}

model PaymentProof {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String        @unique @db.Uuid
  method                PaymentMethod
  transaction_reference String        @unique
  image_key             String
  image_size_bytes      Int
  image_mime            String
  status                ProofStatus   @default(PENDING)
  reviewed_by           String?       @db.Uuid
  reviewed_at           DateTime?     @db.Timestamptz(6)
  reject_reason         String?       @db.Text
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime      @updatedAt @db.Timestamptz(6)

  order                 Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@map("payment_proofs")
}

model Entitlement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id    String            @db.Uuid
  course_id     String            @db.Uuid
  order_id      String?           @db.Uuid
  starts_at     DateTime          @db.Timestamptz(6)
  expires_at    DateTime          @db.Timestamptz(6)
  status        EntitlementStatus @default(ACTIVE)
  revoked_by    String?           @db.Uuid
  revoke_reason String?           @db.Text
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  updated_at    DateTime          @updatedAt @db.Timestamptz(6)

  student       Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course        Course            @relation(fields: [course_id], references: [id], onDelete: Restrict)
  order         Order?            @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([student_id, course_id, expires_at])
  @@index([status, expires_at])
  @@map("entitlements")
}
