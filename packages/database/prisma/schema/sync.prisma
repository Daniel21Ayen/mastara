// ==============================================================================
// Partition F: Offline Outbox Synchronization and Zero-Loss Audit
// Requirements: FR-060 to FR-066, FR-080 to FR-083
// ==============================================================================

model OutboxEvent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operation_id     String   @unique // Time-sortable UUIDv7 operation ID
  student_id       String   @db.Uuid
  device_id_hash   String
  type             String
  payload          Json     @db.JsonB
  client_seq       Int?
  client_timestamp DateTime @db.Timestamptz(6)
  applied_at       DateTime @default(now()) @db.Timestamptz(6)

  student          Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, applied_at])
  @@map("outbox_events")
}
