// ==============================================================================
// Partition B & I: Academic Catalog, Streams and My Course List
// Requirements: FR-010 to FR-019, FR-160 to FR-169, D1, D12
// ==============================================================================

enum Stream {
  NATURAL
  SOCIAL
  COMMON
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model University {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique
  name_en     String
  name_am     String
  logo_url    String?
  status      PublicationStatus @default(PUBLISHED)
  sort_order  Int               @default(0)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  updated_at  DateTime          @updatedAt @db.Timestamptz(6)

  // Relations
  programs    Program[]
  exams       Exam[]
  students    Student[]

  @@index([status, sort_order])
  @@map("universities")
}

model Program {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  university_id String            @db.Uuid
  code          String
  name_en       String
  name_am       String
  status        PublicationStatus @default(PUBLISHED)
  sort_order    Int               @default(0)
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  updated_at    DateTime          @updatedAt @db.Timestamptz(6)

  // Relations
  university    University        @relation(fields: [university_id], references: [id], onDelete: Cascade)
  semesters     Semester[]
  students      Student[]

  @@unique([university_id, code])
  @@index([university_id, status, sort_order])
  @@map("programs")
}

model Semester {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id String            @db.Uuid
  code       String
  name_en    String
  name_am    String
  status     PublicationStatus @default(PUBLISHED)
  sort_order Int               @default(0)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  updated_at DateTime          @updatedAt @db.Timestamptz(6)

  // Relations
  program    Program           @relation(fields: [program_id], references: [id], onDelete: Cascade)
  courses    Course[]
  students   Student[]

  @@unique([program_id, code])
  @@index([program_id, status, sort_order])
  @@map("semesters")
}

model Course {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  semester_id        String            @db.Uuid
  code               String
  title_en           String
  title_am           String
  description_en     String?           @db.Text
  description_am     String?           @db.Text
  stream             Stream
  is_promotional     Boolean           @default(false)
  trial_expiry_days  Int?
  status             PublicationStatus @default(DRAFT)
  sort_order         Int               @default(0)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @updatedAt @db.Timestamptz(6)

  // Relations
  semester           Semester          @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  modules            Module[]
  exams              Exam[]
  student_courses    StudentCourse[]
  entitlements       Entitlement[]
  order_items        OrderItem[]
  questions          Question[]
  coc_questions      CocQuestion[]
  quiz_chapters      QuizChapter[]
  scan_jobs          ScanJob[]

  @@unique([semester_id, code])
  @@index([semester_id, stream, status])
  @@index([is_promotional])
  @@map("courses")
}

model StudentCourse {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id String    @db.Uuid
  course_id  String    @db.Uuid
  added_at   DateTime  @default(now()) @db.Timestamptz(6)
  removed_at DateTime? @db.Timestamptz(6)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)

  student    Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course     Course    @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([student_id, course_id])
  @@index([student_id, is_active])
  @@map("student_courses")
}
