# ── Runtime ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001

# ── PostgreSQL ─────────────────────────────────────────────────────
# Docker Compose maps container:5432 → host:5433
DATABASE_URL="postgresql://mastara:mastara_secure_pass_2026@127.0.0.1:5433/mastara?schema=public"

# Prisma connection pool (optional tuning)
# DATABASE_URL="postgresql://mastara:mastara_secure_pass_2026@127.0.0.1:5433/mastara?schema=public&connection_limit=10&pool_timeout=30"

# ── Redis ──────────────────────────────────────────────────────────
# Docker Compose maps container:6379 → host:6380 (with password)
REDIS_URL="redis://:mastara_redis_pass_2026@127.0.0.1:6380"
QUEUE_DRIVER=redis        # redis | db

# ── File storage ───────────────────────────────────────────────────
STORAGE_DRIVER=local      # local | s3
STORAGE_LOCAL_DIR=./uploads

# S3 / MinIO (used when STORAGE_DRIVER=s3)
# Docker Compose exposes MinIO API on host:9002
MINIO_ENDPOINT=http://127.0.0.1:9002
MINIO_ACCESS_KEY=mastara_admin
MINIO_SECRET_KEY=mastara_minio_pass_2026
MINIO_BUCKET=mastara-uploads
MINIO_REGION=us-east-1

# ── JWT ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-hex-string
JWT_REFRESH_SECRET=change-me-to-a-different-64-char-random-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
