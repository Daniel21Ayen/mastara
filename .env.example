# Node Environment
NODE_ENV=development
PORT=4001

# PostgreSQL
POSTGRES_USER=mastara
POSTGRES_PASSWORD=mastara_secure_pass_2026
POSTGRES_DB=mastara
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5433

# Database Connection String
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_HOST_PORT}/${POSTGRES_DB}?schema=public&sslmode=prefer

# Redis
REDIS_HOST=localhost
REDIS_HOST_PORT=6380
REDIS_PASSWORD=mastara_redis_pass_2026
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_HOST_PORT}

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9002
MINIO_ROOT_USER=mastara_admin
MINIO_ROOT_PASSWORD=mastara_minio_pass_2026
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
S3_REGION=us-east-1
S3_BUCKET_RECEIPTS=mastara-receipts
S3_BUCKET_ASSETS=mastara-assets
S3_FORCE_PATH_STYLE=true

# JWT Authentication
JWT_ACCESS_SECRET=mastara_jwt_access_secret_super_secure_production_baseline_2026
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_SECRET=mastara_jwt_refresh_secret_super_secure_production_baseline_2026
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# Device Security
DEVICE_ENCRYPTION_SECRET=mastara_device_fingerprint_hmac_secret_2026
