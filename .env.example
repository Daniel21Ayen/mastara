# ── Runtime ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4001

# ── PostgreSQL ─────────────────────────────────────────────────────
# In production, use connection_limit and pool_timeout with PgBouncer / Supabase:
DATABASE_URL="postgresql://mastara:YOUR_SECURE_PASSWORD@127.0.0.1:5432/mastara?schema=public&connection_limit=20&pool_timeout=10"

# ── Redis ──────────────────────────────────────────────────────────
# Production Redis with password and appendonly persistence
REDIS_URL="redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379"
QUEUE_DRIVER=redis        # redis | db

# ── File Storage (S3 / R2 / MinIO) ─────────────────────────────────
STORAGE_DRIVER=s3         # local | s3
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com # or AWS/MinIO endpoint
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_PRIVATE_RECEIPTS_BUCKET=mastara-private-receipts
S3_REGION=auto

# ── Security & Authentication Secrets ──────────────────────────────
# Generate high entropy 64-character hex strings: openssl rand -hex 32
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_ACCESS_SECRET=generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=generate_with_openssl_rand_hex_32
COOKIE_SECRET=generate_with_openssl_rand_hex_32
CSRF_HMAC_SECRET=generate_with_openssl_rand_hex_32
TOTP_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
ENTITLEMENT_PRIVATE_KEY="<ed25519_pkcs8_pem_base64_or_multiline>"

# ── CORS Allowlist ─────────────────────────────────────────────────
# Restrict strictly to live admin web domain and mobile origins in production
CORS_ORIGIN=https://admin.yourdomain.com

# ── Monitoring & Sentry ───────────────────────────────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
