{
  "name": "mastara",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:mobile": "npm run start --workspace @mastara/mobile",
    "dev:mobile:web": "npm run web --workspace @mastara/mobile",
    "dev:mobile:tunnel": "npm run start:tunnel --workspace @mastara/mobile",
    "dev:api": "npm run dev --workspace=@mastara/api",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "dev:admin": "npm run dev --workspace @mastara/admin-web",
    "dev:worker": "npm run dev --workspace=@mastara/worker",
    "postinstall": "node scripts/patch-expo-notifications.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.19.0"
  }
}
