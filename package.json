{
  "name": "mastara",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "npm run start --workspace @mastara/mobile",
    "dev:mobile:web": "npm run web --workspace @mastara/mobile",
    "dev:mobile:tunnel": "npm run start:tunnel --workspace @mastara/mobile",
    "dev:api": "npm run dev --workspace=@mastara/api",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "dev:admin": "npm run dev --workspace @mastara/admin-web",
    "dev:worker": "npm run dev --workspace=@mastara/worker",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@mastara/database",
    "check:mocks": "node scripts/ci-check-mocks.mjs",
    "postinstall": "node scripts/apply-patches.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express-serve-static-core": "^5.0.6",
    "eslint": "^9.39.5",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "c12": "^4.0.0-rc.3",
    "cross-spawn": "^7.0.6",
    "exsolve": "^1.1.3",
    "node-emoji": "^2.2.0",
    "picomatch": "^4.0.7",
    "which": "^7.0.0"
  }
}
